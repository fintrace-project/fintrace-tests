{
  "compilerOptions": {
    "target": "es2023",
    // Playwright runs in Node, but what page.evaluate is handed runs in the browser
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
